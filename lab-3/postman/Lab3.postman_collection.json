{
  "info": {
    "name": "Lab 3 Books API",
    "description": "Lab 3 tests: success, not-found and bad-input cases. Reset the database with seed.sql before each run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Success cases",
      "item": [
        {
          "name": "Get all books",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns 10 books\", function () {",
                  "  const books = pm.response.json();",
                  "  pm.expect(books).to.be.an(\"array\");",
                  "  pm.expect(books.length).to.eql(10);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/books/"
          }
        },
        {
          "name": "Search by title (search_q=the)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns 3 matching books\", function () {",
                  "  pm.expect(pm.response.json().length).to.eql(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/books/?search_q=the"
          }
        },
        {
          "name": "Sort by price DESC, limit 3",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"3 books, highest price first\", function () {",
                  "  const books = pm.response.json();",
                  "  pm.expect(books.length).to.eql(3);",
                  "  pm.expect(books[0].price).to.eql(499);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/books/?order_by=price&order=DESC&limit=3"
          }
        },
        {
          "name": "Paging (limit=3, offset=3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"3 books starting at id 4\", function () {",
                  "  const books = pm.response.json();",
                  "  pm.expect(books.length).to.eql(3);",
                  "  pm.expect(books[0].id).to.eql(4);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/books/?limit=3&offset=3"
          }
        },
        {
          "name": "Price range (300 to 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"4 books inside the range\", function () {",
                  "  const books = pm.response.json();",
                  "  pm.expect(books.length).to.eql(4);",
                  "  books.forEach(function (b) { pm.expect(b.price).to.be.within(300, 400); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/books/?min_price=300&max_price=400"
          }
        },
        {
          "name": "Get one book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns book with id 1\", function () {",
                  "  pm.expect(pm.response.json().id).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/books/1"
          }
        },
        {
          "name": "Create book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Returns message and bookId\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.message).to.eql(\"Book created\");",
                  "  pm.expect(body.bookId).to.be.a(\"number\");",
                  "  pm.collectionVariables.set(\"newBookId\", body.bookId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/books/",
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Sapiens\",\"author\":\"Yuval Harari\",\"price\":450,\"pages\":443}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Update message\", function () {",
                  "  pm.expect(pm.response.json().message).to.eql(\"Book updated\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/books/{{newBookId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Sapiens\",\"author\":\"Yuval Harari\",\"price\":500,\"pages\":443}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Delete message\", function () {",
                  "  pm.expect(pm.response.json().message).to.eql(\"Book deleted\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/books/{{newBookId}}"
          }
        }
      ]
    },
